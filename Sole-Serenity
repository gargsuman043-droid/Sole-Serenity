function renderCatalogModal(title){openModal(title||"Explore routines","Pick a routine that feels right for today.",`<div class="filter-bar"><input class="input" id="catalogSearch" placeholder="Search routines or body areas…" value="${esc(currentSearch)}" oninput="currentSearch=this.value;renderCatalogBody()"><select class="select" id="areaFilter" onchange="currentFilterArea=this.value;renderCatalogBody()"><option value="all">All body areas</option>${AREAS.map(a=>`<option value="${a.id}" ${currentFilterArea===a.id?"selected":""}>${a.emoji} ${esc(a.name)}</option>`).join("")}<option value="favorites" ${currentFilterArea==="favorites"?"selected":""}>💜 Favorites only</option></select></div><div class="filter-bar"><button class="filter-chip ${currentTag==="all"?"active":""}" onclick="currentTag='all';renderCatalogBody()">All</button><button class="filter-chip ${currentTag==="Beginner"?"active":""}" onclick="currentTag='Beginner';renderCatalogBody()">Beginner</button><button class="filter-chip ${currentTag==="Gentle"?"active":""}" onclick="currentTag='Gentle';renderCatalogBody()">Gentle</button><button class="filter-chip ${currentTag==="Mindful"?"active":""}" onclick="currentTag='Mindful';renderCatalogBody()">Mindful</button></div><div id="catalogResults" class="routine-catalog"></div><p class="small-note" style="margin-top:15px">You can pause, skip a step, or stop whenever you want.</p>`);renderCatalogBody()}
function renderCatalogBody(){let box=$("catalogResults");if(!box)return;let q=(currentSearch||$("catalogSearch")?.value||"").toLowerCase();currentSearch=q;let list=ROUTINES.filter(r=>(currentFilterArea==="all"||r.areaId===currentFilterArea||(currentFilterArea==="favorites"&&isFavorite(r.id)))&&(currentTag==="all"||r.level===currentTag)&&(r.title+" "+r.description+" "+r.area+" "+r.tags.join(" ")).toLowerCase().includes(q));box.innerHTML=list.length?list.map(catalogCard).join(""):`<div class="empty-state"><div class="empty-emoji">🔎</div><h3>No routines found</h3><p>Try another search or choose a different filter.</p></div>`}
function beginRoutine(id){let r=routineById(id);if(!r)return;activeRoutine=r;currentStep=0;paused=true;stopTimer();renderSession()}
function renderSession(){if(!activeRoutine)return;let r=activeRoutine,s=r.steps[currentStep];timerTotal=s.seconds;timerRemaining=timerTotal;let list=r.steps.map((x,i)=>`<div class="session-step ${i===currentStep?"current":""} ${i<currentStep?"done":""}"><div class="step-top"><span class="step-number">${i<currentStep?"✓":i+1}</span><h3>${esc(x.title)}</h3><span class="step-time">${x.duration}</span></div><p>${esc(x.description)}</p></div>`).join("");openModal(r.title,`${r.duration}-minute guided self-care routine`,`${currentStep===0?`<div class="safety-box"><strong>Comfort check:</strong> ${esc(r.safety)} Stop if anything hurts.</div>`:""}<div class="session-layout"><div class="timer-card"><div class="kicker">STEP ${currentStep+1} OF ${r.steps.length}</div><div class="timer-ring" id="timerRing" style="--timer-progress:0%"><div class="timer-inner"><div class="timer-time" id="timerTime">${fmt(timerRemaining)}</div><div class="timer-label" id="timerLabel">Ready when you are</div></div></div><h3 style="margin:0">${esc(s.title)}</h3><p style="font-size:.82rem;color:var(--muted)">${esc(s.description)}</p><div class="session-controls"><button class="btn btn-primary" id="timerStart" onclick="toggleTimer()">▶ Start</button><button class="btn btn-soft" onclick="nextStep()">Skip step →</button></div><button class="btn btn-white" style="margin-top:9px;width:100%" onclick="stopAndClose()">End session</button></div><div><div id="sessionSteps">${list}</div><p class="small-note">The timer is a guide, not a performance goal. Take longer or stop early if you prefer.</p></div></div>`);updateTimerUI()}
function fmt(s){s=Math.max(0,Math.floor(s));return `${String(Math.floor(s/60)).padStart(2,"0")}:${String(s%60).padStart(2,"0")}`}
function toggleTimer(){if(!activeRoutine)return;if(!paused){paused=true;stopTimer();updateTimerUI();return}paused=false;$("timerLabel").textContent="Take your time";$("timerStart").textContent="Ⅱ Pause";timerInterval=setInterval(()=>{if(timerRemaining>0){timerRemaining--;updateTimerUI()}else{stopTimer();paused=true;toast("Step complete. Move on when you're ready.");nextStep(true)}},1000)}
function stopTimer(){if(timerInterval){clearInterval(timerInterval);timerInterval=null}}
function updateTimerUI(){if(!$("timerTime"))return;$("timerTime").textContent=fmt(timerRemaining);$("timerRing").style.setProperty("--timer-progress",(timerTotal?(timerTotal-timerRemaining)/timerTotal*100:0)+"%");if($("timerStart"))$("timerStart").textContent=paused?"▶ Start":"Ⅱ Pause"}
function nextStep(){if(!activeRoutine)return;stopTimer();paused=true;if(currentStep<activeRoutine.steps.length-1){currentStep++;renderSession()}else completeSession()}
function completeSession(){stopTimer();paused=true;let r=activeRoutine;state.history.push({id:r.id,title:r.title,minutes:r.duration,date:new Date().toISOString()});saveState();activeRoutine=null;openModal("Lovely work ✨","You made a little space for yourself.",`<div class="complete-banner"><h3>Session complete</h3><p>You finished “${esc(r.title)}.” Take a moment to notice how you feel. You do not need to feel different for this time to count.</p></div><div class="panel panel-pad"><strong>${r.duration} minutes of self-care</strong><p class="small-note">Your session was added to this browser's local progress.</p></div><div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:18px"><button class="btn btn-primary" onclick="closeModal();openCatalog()">Choose another routine</button><button class="btn btn-soft" onclick="closeModal()">Done for now</button></div>`);toast("Session saved. Nice work!")}
function stopAndClose(){stopTimer();paused=true;activeRoutine=null;closeModal();toast("Session ended. You can return any time.")}
