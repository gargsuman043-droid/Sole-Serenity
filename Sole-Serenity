function openModal(t,sub,b){$("modalTitle").textContent=t;$("modalSubtitle").textContent=sub||"";$("modalBody").innerHTML=b;$("modalBackdrop").classList.remove("hidden");document.body.style.overflow="hidden"}
function closeModal(){stopTimer();$("modalBackdrop").classList.add("hidden");document.body.style.overflow=""}
function backdropClose(e){if(e.target===$("modalBackdrop"))closeModal()}
function routineById(id){return ROUTINES.find(r=>r.id===id)}
function isFavorite(id){return state.favorites.includes(id)}
function favoriteButton(r){return `<button class="heart ${isFavorite(r.id)?"saved":""}" onclick="toggleFavorite('${r.id}')" aria-label="Toggle favorite">${isFavorite(r.id)?"♥":"♡"}</button>`}
function routineRow(r){return `<div class="routine-row"><div class="routine-emoji">${r.emoji}</div><div class="routine-info"><h3>${esc(r.title)}</h3><p>${esc(r.description)}</p><div class="routine-meta"><span class="pill">⏱ ${r.duration} min</span><span class="pill">${esc(r.level)}</span></div></div><div class="row-actions">${favoriteButton(r)}<button class="btn btn-primary" onclick="beginRoutine('${r.id}')">Start</button></div></div>`}
function catalogCard(r){return `<article class="catalog-card"><div class="routine-emoji">${r.emoji}</div><div class="grow"><h3>${esc(r.title)}</h3><p>${esc(r.description)}</p><div class="routine-meta"><span class="pill">${r.duration} min</span><span class="pill">${esc(r.area)}</span><span class="pill">${esc(r.level)}</span></div></div>${favoriteButton(r)}<button class="btn btn-primary" onclick="beginRoutine('${r.id}')">Start →</button></article>`}
function renderAreas(){$("areaGrid").innerHTML=AREAS.map(a=>`<button class="area-card" onclick="openArea('${a.id}')"><span class="area-arrow">↗</span><span class="area-emoji">${a.emoji}</span><h3>${esc(a.name)}</h3><p>${esc(a.description)}</p><span class="mini-pill">${ROUTINES.filter(r=>r.areaId===a.id).length} guided routines</span></button>`).join("")}
function renderFeatured(){$("featuredRoutines").innerHTML=["shoulders-1","arms-2","feet-3","fullbody-4"].map(routineById).filter(Boolean).map(routineRow).join("")}
function renderTips(){const tips=[["🫧","Keep it gentle","Pressure should feel comfortable, never sharp or painful."],["🌬️","Let breathing stay easy","Do not hold your breath or force a stretch."],["🛑","Stop when something feels wrong","Discomfort is a reason to pause, not push through."],["🧴","Use clean hands","Avoid touching irritated or broken skin."]];$("tipsList").innerHTML=tips.map(t=>`<div class="tip"><span class="tip-icon">${t[0]}</span><div><strong>${t[1]}</strong><p>${t[2]}</p></div></div>`).join("")}
function renderStats(){let h=state.history||[],cut=new Date();cut.setDate(cut.getDate()-6);cut.setHours(0,0,0,0);let recent=h.filter(x=>new Date(x.date)>=cut);$("statSessions").textContent=h.length;$("statMinutes").textContent=h.reduce((s,x)=>s+(x.minutes||0),0);$("statFavorites").textContent=state.favorites.length;$("statDays").textContent=new Set(recent.map(x=>x.date.slice(0,10))).size}
function renderWeekly(){let box=$("weeklyChart");if(!box)return;let names=["Sun","Mon","Tue","Wed","Thu","Fri","Sat"],today=new Date(),days=[];for(let i=6;i>=0;i--){let d=new Date(today);d.setDate(today.getDate()-i);let key=d.toISOString().slice(0,10);days.push({label:names[d.getDay()],count:(state.history||[]).filter(h=>h.date.slice(0,10)===key).length})}let max=Math.max(1,...days.map(d=>d.count));box.innerHTML=`<div style="display:grid;grid-template-columns:repeat(7,1fr);gap:10px;align-items:end;height:145px;margin:18px 0 12px">${days.map(d=>`<div style="display:flex;flex-direction:column;align-items:center;gap:8px;height:100%;justify-content:end"><span style="font-size:.75rem;color:var(--muted);font-weight:800">${d.count||""}</span><div title="${d.count} sessions" style="width:100%;max-width:38px;height:${Math.max(8,d.count/max*78)}px;border-radius:10px 10px 4px 4px;background:${d.count?"linear-gradient(180deg,#bba6f4,#7654c8)":"#eee8f7"}"></div><span style="font-size:.72rem;color:var(--muted)">${d.label}</span></div>`).join("")}</div>`}
function renderFavorites(){let box=$("favoritePreview");if(!box)return;let fav=state.favorites.map(routineById).filter(Boolean).slice(0,3);box.innerHTML=fav.length?fav.map(routineRow).join(""):`<div class="empty-state"><div class="empty-emoji">💜</div><h3>Your favorites will live here</h3><p>Tap the heart on a routine to save it for another day.</p><br><button class="btn btn-soft" onclick="openCatalog()">Explore routines</button></div>`}
function toggleFavorite(id){state.favorites=isFavorite(id)?state.favorites.filter(x=>x!==id):[...state.favorites,id];saveState();toast(isFavorite(id)?"Saved to favorites 💜":"Removed from favorites.");if(!$("modalBackdrop").classList.contains("hidden")&&$("catalogResults"))renderCatalogBody()}
